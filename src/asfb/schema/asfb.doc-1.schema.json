{
  "$defs": {
    "Attr": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnumValue"
            },
            {
              "pattern": "^t_[0-9a-f]{16}$",
              "type": "string"
            }
          ],
          "title": "Name"
        },
        "value": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "pattern": "^t_[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "$ref": "#/$defs/EnumValue"
            },
            {
              "$ref": "#/$defs/Url"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/EnumValue"
                  },
                  {
                    "pattern": "^t_[0-9a-f]{16}$",
                    "type": "string"
                  }
                ]
              },
              "maxItems": 128,
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Attr",
      "type": "object"
    },
    "Doctype": {
      "additionalProperties": false,
      "properties": {
        "html": {
          "title": "Html",
          "type": "boolean"
        },
        "kind": {
          "const": "doctype",
          "default": "doctype",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "html"
      ],
      "title": "Doctype",
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "properties": {
        "attrs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Attr"
          },
          "maxItems": 64,
          "title": "Attrs",
          "type": "array"
        },
        "children": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "doctype": "#/$defs/Doctype",
                "element": "#/$defs/Element",
                "opaque": "#/$defs/Opaque",
                "text": "#/$defs/Text"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Element"
              },
              {
                "$ref": "#/$defs/Text"
              },
              {
                "$ref": "#/$defs/Opaque"
              },
              {
                "$ref": "#/$defs/Doctype"
              }
            ]
          },
          "maxItems": 20000,
          "title": "Children",
          "type": "array"
        },
        "kind": {
          "const": "element",
          "default": "element",
          "title": "Kind",
          "type": "string"
        },
        "tag": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnumValue"
            },
            {
              "pattern": "^t_[0-9a-f]{16}$",
              "type": "string"
            }
          ],
          "title": "Tag"
        }
      },
      "required": [
        "tag"
      ],
      "title": "Element",
      "type": "object"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "term": {
          "pattern": "^[!-~]{1,64}$",
          "title": "Term",
          "type": "string"
        },
        "vocab": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$",
          "title": "Vocab",
          "type": "string"
        }
      },
      "required": [
        "vocab",
        "term"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "Opaque": {
      "additionalProperties": false,
      "properties": {
        "form": {
          "$ref": "#/$defs/OpaqueForm"
        },
        "kind": {
          "const": "opaque",
          "default": "opaque",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "pattern": "^t_[0-9a-f]{16}$",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "form",
        "text"
      ],
      "title": "Opaque",
      "type": "object"
    },
    "OpaqueForm": {
      "enum": [
        "comment",
        "cdata",
        "pi",
        "decl"
      ],
      "title": "OpaqueForm",
      "type": "string"
    },
    "Profile": {
      "enum": [
        "strict",
        "diffable"
      ],
      "title": "Profile",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "html"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "Text": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text",
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "pattern": "^t_[0-9a-f]{16}$",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Text",
      "type": "object"
    },
    "Url": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "anyOf": [
            {
              "pattern": "^t_[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authority"
        },
        "fragment": {
          "anyOf": [
            {
              "pattern": "^t_[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragment"
        },
        "path": {
          "default": [],
          "items": {
            "pattern": "^t_[0-9a-f]{16}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Path",
          "type": "array"
        },
        "query": {
          "anyOf": [
            {
              "pattern": "^t_[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "rooted": {
          "default": false,
          "title": "Rooted",
          "type": "boolean"
        },
        "scheme": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnumValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trailing_slash": {
          "default": false,
          "title": "Trailing Slash",
          "type": "boolean"
        }
      },
      "title": "Url",
      "type": "object"
    },
    "VocabRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "VocabRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "items": {
        "discriminator": {
          "mapping": {
            "doctype": "#/$defs/Doctype",
            "element": "#/$defs/Element",
            "opaque": "#/$defs/Opaque",
            "text": "#/$defs/Text"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Element"
          },
          {
            "$ref": "#/$defs/Text"
          },
          {
            "$ref": "#/$defs/Opaque"
          },
          {
            "$ref": "#/$defs/Doctype"
          }
        ]
      },
      "maxItems": 20000,
      "title": "Body",
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "schema_id": {
      "const": "asfb.doc/1",
      "default": "asfb.doc/1",
      "title": "Schema Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceKind"
    },
    "vocab": {
      "items": {
        "$ref": "#/$defs/VocabRef"
      },
      "title": "Vocab",
      "type": "array"
    }
  },
  "required": [
    "profile",
    "source",
    "vocab",
    "body"
  ],
  "title": "DocV1",
  "type": "object"
}
